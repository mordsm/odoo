<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Form View -->
	<record id="view_l10n_il_vat_report_form" model="ir.ui.view">
		<field name="name">l10n.il.vat.report.form</field>
		<field name="model">l10n.il.vat.report</field>
		<field name="arch" type="xml">
			<form string="דוח מע״מ ישראלי">
				<header>
					<button name="action_calculate" string="חישוב" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
					<button name="action_generate_file" string="הפקת קובץ דיווח" type="object"
                            class="oe_highlight" invisible="state != 'calculated'"/>
					<button name="action_draft" string="אפס לטיוטה" type="object"
                            invisible="state not in ('calculated', 'done')"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,calculated,done"/>
				</header>
				<sheet>
					<div class="oe_title">
						<h1>
							<field name="name"/>
						</h1>
					</div>
					<group>
						<group>
							<field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
							<field name="date_from"/>
							<field name="date_to"/>
							<field name="currency_id" invisible="1"/>
						</group>
					</group>

					<notebook invisible="state == 'draft'">
						<page string="Summary" name="summary">
							<group>
								<group string="Output VAT (Sales)">
									<field name="output_vat_base"/>
									<field name="output_vat_tax"/>
								</group>
								<group string="Input VAT (Purchases)">
									<field name="input_vat_base"/>
									<field name="input_vat_tax"/>
								</group>
							</group>
							<group>
								<group string="Other Transactions">
									<field name="export_vat_base"/>
									<field name="import_vat_base"/>
									<field name="import_vat_tax"/>
									<field name="exempt_vat_base"/>
								</group>
								<group string="Result">
									<field name="vat_payable" class="oe_subtotal_footer_separator"/>
								</group>
							</group>
							<div invisible="report_file == False">
								<h3>Generated Report File:</h3>
								<field name="report_filename" invisible="1"/>
								<field name="report_file" filename="report_filename" readonly="1"/>
							</div>
						</page>
						<page string="Details" name="details">
							<field name="line_ids">
								<list>
									<field name="date"/>
									<field name="partner_id"/>
									<field name="move_id"/>
									<field name="move_type"/>
									<field name="amount_untaxed"/>
									<field name="amount_tax"/>
									<field name="amount_total"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<!-- list View -->
	<record id="view_l10n_il_vat_report_list" model="ir.ui.view">
		<field name="name">l10n.il.vat.report.list</field>
		<field name="model">l10n.il.vat.report</field>
		<field name="arch" type="xml">
			<list string="Israeli VAT Reports">
				<field name="name"/>
				<field name="date_from"/>
				<field name="date_to"/>
				<field name="output_vat_tax" sum="Total Output VAT"/>
				<field name="input_vat_tax" sum="Total Input VAT"/>
				<field name="vat_payable" sum="Total VAT Payable"/>
				<field name="state"/>
			</list>
		</field>
	</record>

	<!-- Search View -->
	<record id="view_l10n_il_vat_report_search" model="ir.ui.view">
		<field name="name">l10n.il.vat.report.search</field>
		<field name="model">l10n.il.vat.report</field>
		<field name="arch" type="xml">
			<search string="Search VAT Reports">
				<field name="name"/>
				<filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
				<filter string="Calculated" name="calculated" domain="[('state', '=', 'calculated')]"/>
				<filter string="Submitted" name="done" domain="[('state', '=', 'done')]"/>
				<separator/>
				<filter string="This Year" name="this_year" domain="[('date_from', '>=', time.strftime('%Y-01-01'))]"/>
				<group expand="0" string="Group By">
					<filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>
				</group>
			</search>
		</field>
	</record>

	<!-- Action -->
	<record id="action_l10n_il_vat_report" model="ir.actions.act_window">
		<field name="name">VAT Reports</field>
		<field name="res_model">l10n.il.vat.report</field>
		<field name="view_mode">list,form</field>
		<field name="search_view_id" ref="view_l10n_il_vat_report_search"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Create your first VAT report
			</p>
			<p>
				Generate and submit your VAT reports to the Israeli Tax Authority.
			</p>
		</field>
	</record>
</odoo>