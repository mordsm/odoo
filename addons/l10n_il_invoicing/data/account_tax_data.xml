<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="1">
		<!-- Tax Groups -->
		<record id="tax_group_vat_18" model="account.tax.group">
			<field name="name">VAT 18%</field>
			<field name="l10n_il_report_section">output</field>
		</record>

		<record id="tax_group_vat_input" model="account.tax.group">
			<field name="name">VAT Input</field>
			<field name="l10n_il_report_section">input</field>
		</record>

		<record id="tax_group_vat_exempt" model="account.tax.group">
			<field name="name">VAT Exempt</field>
			<field name="l10n_il_report_section">exempt</field>
		</record>

		<!-- Sales Taxes -->
		<record id="vat_sale_18" model="account.tax">
			<field name="name">VAT 18%</field>
			<field name="type_tax_use">sale</field>
			<field name="amount">18</field>
			<field name="amount_type">percent</field>
			<field name="description">Standard rate</field>
			<field name="tax_group_id" ref="tax_group_vat_18"/>
			<field name="l10n_il_vat_category">standard</field>
			<field name="l10n_il_report_line">vat_sales</field>
		</record>

		<record id="vat_sale_exempt" model="account.tax">
			<field name="name">VAT Exempt Sale</field>
			<field name="type_tax_use">sale</field>
			<field name="amount">0</field>
			<field name="amount_type">percent</field>
			<field name="description">VAT Exempt</field>
			<field name="tax_group_id" ref="tax_group_vat_exempt"/>
			<field name="l10n_il_vat_category">exempt</field>
			<field name="l10n_il_report_line">vat_exempt</field>
		</record>

		<record id="vat_sale_export" model="account.tax">
			<field name="name">Export (0%)</field>
			<field name="type_tax_use">sale</field>
			<field name="amount">0</field>
			<field name="amount_type">percent</field>
			<field name="description">Zero-rated export</field>
			<field name="tax_group_id" ref="tax_group_vat_exempt"/>
			<field name="l10n_il_vat_category">export</field>
			<field name="l10n_il_report_line">vat_export</field>
		</record>

		<!-- Purchase Taxes -->
		<record id="vat_purchase_18" model="account.tax">
			<field name="name">VAT 18% on Purchases</field>
			<field name="type_tax_use">purchase</field>
			<field name="amount">18</field>
			<field name="amount_type">percent</field>
			<field name="description">Standard rate on purchases</field>
			<field name="tax_group_id" ref="tax_group_vat_input"/>
			<field name="l10n_il_vat_category">standard</field>
			<field name="l10n_il_report_line">vat_purchases</field>
		</record>

		<record id="vat_purchase_exempt" model="account.tax">
			<field name="name">VAT Exempt Purchase</field>
			<field name="type_tax_use">purchase</field>
			<field name="amount">0</field>
			<field name="amount_type">percent</field>
			<field name="description">VAT Exempt purchase</field>
			<field name="tax_group_id" ref="tax_group_vat_exempt"/>
			<field name="l10n_il_vat_category">exempt</field>
			<field name="l10n_il_report_line">vat_exempt</field>
		</record>

		<record id="vat_purchase_import" model="account.tax">
			<field name="name">Import VAT 18%</field>
			<field name="type_tax_use">purchase</field>
			<field name="amount">18</field>
			<field name="amount_type">percent</field>
			<field name="description">VAT on imports</field>
			<field name="tax_group_id" ref="tax_group_vat_input"/>
			<field name="l10n_il_vat_category">import</field>
			<field name="l10n_il_report_line">vat_import</field>
		</record>
	</data>
</odoo>