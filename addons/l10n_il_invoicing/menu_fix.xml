<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!--
    This file defines both actions and menus in one place.
    It uses multiple parent menu references to increase the chance
    that at least one will work in your environment.
    -->

	<!-- Define form view for the income tax report wizard -->
	<record id="view_l10n_il_income_tax_report_wizard_form" model="ir.ui.view">
		<field name="name">l10n_il.income.tax.report.wizard.form</field>
		<field name="model">l10n_il.income.tax.report.wizard</field>
		<field name="arch" type="xml">
			<form string="דוחות מס הכנסה">
				<sheet>
					<group>
						<group>
							<field name="date_from"/>
							<field name="date_to"/>
							<field name="company_id" groups="base.group_multi_company"/>
						</group>
						<group>
							<field name="report_type"/>
							<field name="include_social_security"/>
							<field name="include_health_insurance"/>
						</group>
					</group>
					<field name="report_data" invisible="1"/>
				</sheet>
				<footer>
					<button name="action_generate_report" string="הפק דוח" type="object" class="btn-primary"/>
					<button string="ביטול" class="btn-secondary" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>

	<!-- Income Tax Report Action -->
	<record id="action_l10n_il_income_tax_report_wizard" model="ir.actions.act_window">
		<field name="name">דוחות מס הכנסה</field>
		<field name="res_model">l10n_il.income.tax.report.wizard</field>
		<field name="view_mode">form</field>
		<field name="view_id" ref="view_l10n_il_income_tax_report_wizard_form"/>
		<field name="target">new</field>
	</record>

	<!-- Income Tax Tables Action -->
	<record id="action_l10n_il_income_tax" model="ir.actions.act_window">
		<field name="name">טבלאות מס הכנסה</field>
		<field name="res_model">l10n_il.income.tax</field>
		<field name="view_mode">tree,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				צור טבלת מס הכנסה חדשה
			</p>
		</field>
	</record>

	<!-- Try different parent menu references for Israeli Reports -->
	<!-- Option 1: Standard account module path -->
	<menuitem id="menu_l10n_il_income_tax_report1"
              name="דוחות מס הכנסה"
              action="action_l10n_il_income_tax_report_wizard"
              parent="account.menu_finance_reports"
              groups="account.group_account_user"
              sequence="150"/>

	<!-- Option 2: Direct parent for Israeli reports -->
	<menuitem id="menu_israeli_reports"
              name="דוחות ישראליים"
              parent="account.menu_finance_reports"
              groups="account.group_account_user"
              sequence="90"/>

	<menuitem id="menu_l10n_il_income_tax_report2"
              name="דוחות מס הכנסה"
              action="action_l10n_il_income_tax_report_wizard"
              parent="menu_israeli_reports"
              groups="account.group_account_user"
              sequence="20"/>

	<!-- Option 3: Try common l10n_il path -->
	<menuitem id="menu_l10n_il_income_tax_report3"
              name="דוחות מס הכנסה"
              action="action_l10n_il_income_tax_report_wizard"
              parent="l10n_il.menu_il_reports"
              groups="account.group_account_user"
              sequence="20"/>

	<!-- Configuration menu items -->
	<menuitem id="menu_l10n_il_income_tax1"
              name="טבלאות מס הכנסה"
              action="action_l10n_il_income_tax"
              parent="account.menu_finance_configuration"
              groups="account.group_account_user"
              sequence="150"/>

	<menuitem id="menu_l10n_il_income_tax2"
              name="טבלאות מס הכנסה"
              action="action_l10n_il_income_tax"
              parent="l10n_il.menu_il_config"
              groups="account.group_account_user"
              sequence="20"/>
</odoo>