<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Financial Transaction List View -->
    <record id="view_financial_transaction_list" model="ir.ui.view">
        <field name="name">financial.transaction.list</field>
        <field name="model">financial.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="transaction_date"/>
                <field name="name"/>
                <field name="account_number"/>
                <field name="amount"/>
                <field name="currency"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <!-- Financial Transaction Form View -->
    <record id="view_financial_transaction_form" model="ir.ui.view">
        <field name="name">financial.transaction.form</field>
        <field name="model">financial.transaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="account_number"/>
                    </group>
                    <group>
                        <field name="transaction_date"/>
                        <field name="value_date"/>
                        <field name="transaction_code"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="currency"/>
                        <field name="reference"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_financial_transaction" model="ir.actions.act_window">
        <field name="name">Financial Transactions</field>
        <field name="res_model">financial.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>