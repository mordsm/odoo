<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="1">
		<!-- Security Categories -->
		<record id="module_category_l10n_il_income_tax" model="ir.module.category">
			<field name="name">Israeli Income Tax</field>
			<field name="description">Helps you manage Israeli income tax reporting</field>
			<field name="sequence">50</field>
		</record>

		<!-- Security Groups -->
		<record id="group_l10n_il_income_tax_user" model="res.groups">
			<field name="name">User</field>
			<field name="category_id" ref="module_category_l10n_il_income_tax"/>
			<field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
		</record>

		<record id="group_l10n_il_income_tax_manager" model="res.groups">
			<field name="name">Manager</field>
			<field name="category_id" ref="module_category_l10n_il_income_tax"/>
			<field name="implied_ids" eval="[(4, ref('group_l10n_il_income_tax_user'))]"/>
			<field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
		</record>

		<!-- Record Rules -->
		<record id="rule_l10n_il_income_tax_company" model="ir.rule">
			<field name="name">Israeli Income Tax: Multi-Company</field>
			<field name="model_id" ref="model_l10n_il_income_tax"/>
			<field name="global" eval="True"/>
			<field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
		</record>

		<record id="rule_l10n_il_corporate_tax_return_company" model="ir.rule">
			<field name="name">Israeli Corporate Tax Return: Multi-Company</field>
			<field name="model_id" ref="model_l10n_il_corporate_tax_return"/>
			<field name="global" eval="True"/>
			<field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
		</record>

		<record id="rule_l10n_il_depreciation_schedule_company" model="ir.rule">
			<field name="name">Israeli Depreciation Schedule: Multi-Company</field>
			<field name="model_id" ref="model_l10n_il_depreciation_schedule"/>
			<field name="global" eval="True"/>
			<field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
		</record>
	</data>
</odoo>